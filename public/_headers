# Netlify / Cloudflare Pages security headers.
# Applies to every route. Adjust the CSP if you later add a third-party
# script/embed beyond Google Fonts and Google Analytics (gtag.js) — anything
# not listed here will be blocked by the CSP below.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; frame-ancestors 'none'

# Never let the Cloudflare Pages preview domain get indexed — the real
# production domain (salarioclaro.com) is the only one that should show up
# in search results. This is a true HTTP header sent by Cloudflare's edge
# before any HTML/JS is even parsed, so it also catches crawlers that don't
# execute JavaScript.
https://salario-claro.pages.dev/*
  X-Robots-Tag: noindex

# Static assets can be cached aggressively — filenames are content-hashed by Astro's build.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

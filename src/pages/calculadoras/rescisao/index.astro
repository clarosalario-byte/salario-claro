---
import Layout from '../../../layouts/Layout.astro';
import ResultActions from '../../../components/ResultActions.astro';
import AllCalculatorsNav from '../../../components/AllCalculatorsNav.astro';
import { organizationRef, breadcrumbSchema, SITE_URL } from '../../../lib/seo/schema';

const title = 'Calculadora de Rescisão CLT | Salário Claro';
const description =
  'Calcule as verbas rescisórias por tipo de desligamento: saldo de salário, aviso prévio, férias, 13º proporcional e multa do FGTS, com as regras de 2026.';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${SITE_URL}/calculadoras/rescisao/#webapplication`,
  name: 'Calculadora de Rescisão CLT',
  url: `${SITE_URL}/calculadoras/rescisao/`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (navegador web)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  publisher: organizationRef(),
};
const breadcrumb = breadcrumbSchema([
  { name: 'Início', path: '/' },
  { name: 'Calculadoras', path: '/calculadoras/' },
  { name: 'Rescisão CLT', path: '/calculadoras/rescisao/' },
]);
---
<Layout title={title} description={description} path="/calculadoras/rescisao/" structuredData={[webAppSchema, breadcrumb]}>
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">Calculadora de rescisão CLT</h1>
    <p class="mt-3 text-ink-soft">
      As verbas devidas mudam conforme o tipo de desligamento. Por isso, pedimos essa informação
      em vez de supor.
    </p>

    <form id="calc-form" class="card-premium mt-8 space-y-5 rounded-xl p-6" novalidate>
      <div>
        <label for="monthlySalary" class="block text-sm font-medium text-ink">Salário mensal</label>
        <div class="mt-1.5 flex max-w-xs items-center rounded-md border border-line focus-within:border-ink">
          <span class="pl-3 text-ink-soft">R$</span>
          <input type="text" inputmode="decimal" id="monthlySalary" placeholder="3.000,00"
            class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" required />
        </div>
        <p id="monthlySalary-error" class="mt-1 text-sm text-bad" role="alert"></p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="admissionDate" class="block text-sm font-medium text-ink">Data de admissão</label>
          <input type="date" id="admissionDate" class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" required />
        </div>
        <div>
          <label for="terminationDate" class="block text-sm font-medium text-ink">Data de rescisão</label>
          <input type="date" id="terminationDate" class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" required />
        </div>
      </div>
      <p id="dates-error" class="text-sm text-bad" role="alert"></p>

      <div>
        <label for="scenario" class="block text-sm font-medium text-ink">Tipo de desligamento</label>
        <select id="scenario" class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink">
          <option value="no-cause">Dispensa sem justa causa</option>
          <option value="resignation">Pedido de demissão</option>
          <option value="just-cause">Dispensa por justa causa</option>
          <option value="mutual-agreement">Acordo mútuo (distrato, art. 484-A CLT)</option>
        </select>
      </div>

      <details class="rounded-md border border-line p-4">
        <summary class="cursor-pointer select-none text-sm font-medium text-ink">Mais opções</summary>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="overdueVacationDays" class="block text-sm font-medium text-ink">Dias de férias vencidas</label>
            <input type="number" id="overdueVacationDays" min="0" max="30" value="0"
              class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
            <p class="mt-1 text-xs text-ink-soft">Férias já adquiridas em período anterior e ainda não gozadas.</p>
          </div>
          <div>
            <label for="fgtsBalance" class="block text-sm font-medium text-ink">Saldo do FGTS (opcional)</label>
            <div class="mt-1.5 flex items-center rounded-md border border-line focus-within:border-ink">
              <span class="pl-3 text-ink-soft">R$</span>
              <input type="text" inputmode="decimal" id="fgtsBalance" placeholder="0,00"
                class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" />
            </div>
            <p class="mt-1 text-xs text-ink-soft">Para calcular a multa. Use o extrato oficial (app FGTS).</p>
          </div>
          <div>
            <label for="dependents" class="block text-sm font-medium text-ink">Dependentes</label>
            <input type="number" id="dependents" min="0" value="0"
              class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
          </div>
          <div>
            <label for="alimony" class="block text-sm font-medium text-ink">Pensão alimentícia</label>
            <div class="mt-1.5 flex items-center rounded-md border border-line focus-within:border-ink">
              <span class="pl-3 text-ink-soft">R$</span>
              <input type="text" inputmode="decimal" id="alimony" placeholder="0,00"
                class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" />
            </div>
          </div>
        </div>
      </details>

      <button type="submit" class="btn-primary rounded-md px-6 py-2.5 text-sm font-medium">Calcular</button>
    </form>

    <div id="result" class="card-premium mt-8 hidden rounded-xl p-6" aria-live="polite">
      <p class="text-sm text-ink-soft">Total líquido estimado da rescisão</p>
      <p id="result-value" class="mt-1 font-display text-4xl font-semibold tabular-money text-ink"></p>

      <dl class="mt-6 divide-y divide-line border-t border-line text-sm">
        <div class="flex justify-between py-2"><dt class="text-ink-soft">Saldo de salário (<span id="r-balance-days"></span> dias)</dt><dd id="r-balance" class="tabular-money"></dd></div>
        <div id="r-notice-row" class="hidden justify-between py-2">
          <dt class="text-ink-soft">Aviso prévio indenizado (<span id="r-notice-days"></span> dias, isento)</dt><dd id="r-notice" class="tabular-money"></dd>
        </div>
        <div id="r-overdue-row" class="hidden justify-between py-2">
          <dt class="text-ink-soft">Férias vencidas</dt><dd id="r-overdue" class="tabular-money"></dd>
        </div>
        <div id="r-propvac-row" class="hidden justify-between py-2">
          <dt class="text-ink-soft">Férias proporcionais (<span id="r-propvac-months"></span> meses)</dt><dd id="r-propvac" class="tabular-money"></dd>
        </div>
        <div id="r-third-row" class="hidden justify-between py-2">
          <dt class="text-ink-soft">1/3 constitucional sobre férias</dt><dd id="r-third" class="tabular-money"></dd>
        </div>
        <div id="r-13-row" class="hidden justify-between py-2">
          <dt class="text-ink-soft">13º proporcional (<span id="r-13-months"></span> meses)</dt><dd id="r-13" class="tabular-money"></dd>
        </div>
        <div class="flex justify-between py-2"><dt class="text-ink-soft">INSS total</dt><dd id="r-inss" class="tabular-money text-bad"></dd></div>
        <div class="flex justify-between py-2"><dt class="text-ink-soft">IRRF total</dt><dd id="r-irrf" class="tabular-money text-bad"></dd></div>
        <div id="r-fgts-row" class="hidden justify-between py-2">
          <dt class="text-ink-soft">Multa do FGTS (<span id="r-fgts-rate"></span>)</dt><dd id="r-fgts" class="tabular-money"></dd>
        </div>
      </dl>

      <ResultActions />

      <p class="mt-4 text-xs text-ink-soft">
        Este cálculo é uma estimativa e não substitui o cálculo oficial da rescisão nem a orientação
        de um profissional de contabilidade ou advogado trabalhista. Veja as limitações desta
        calculadora em <a href="/como-calculamos/" class="text-ink underline hover:text-accent-ink">Como calculamos</a>.
      </p>
    </div>

    <div class="prose-custom mt-12 space-y-4 text-ink">
      <h2 class="font-display text-xl font-semibold">Como calculamos</h2>
      <p class="text-ink-soft">
        As verbas devidas dependem do tipo de desligamento. Em <strong>dispensa sem justa causa</strong>,
        são devidos saldo de salário, aviso prévio (30 dias + 3 por ano completo de serviço, até 90),
        férias vencidas e proporcionais + 1/3, 13º proporcional, e multa de 40% sobre o FGTS. Em
        <strong>acordo mútuo</strong> (art. 484-A da CLT), o aviso prévio é pago pela metade e a
        multa do FGTS é de 20%. Em <strong>pedido de demissão</strong>, não há aviso prévio pago ao
        empregado nem multa do FGTS, mas férias e 13º proporcionais continuam devidos. Em
        <strong>dispensa por justa causa</strong>, apenas o saldo de salário e férias já vencidas são
        devidos. A Súmula 171 do TST confirma que não há direito a proporcionais nesse caso.
      </p>
      <p class="text-ink-soft">
        <strong>Limitação importante:</strong> quando o aviso prévio é indenizado, a Súmula 371 do
        TST prevê a "projeção" da data de saída para efeito de contagem de tempo, o que pode
        aumentar as proporcionais em até 90 dias. Esta calculadora NÃO aplica essa projeção, o que
        pode subestimar levemente o valor em dispensas sem justa causa. Consulte um profissional
        para o valor exato nesse cenário.
      </p>
    </div>
    <AllCalculatorsNav currentPath="/calculadoras/rescisao/" />
  </section>
</Layout>

<script>
  import { calculateTermination, type TerminationScenario } from '../../../lib/calculations/termination';
  import { formatBRL } from '../../../lib/calculations/salary';
  import { downloadResultImage, copyResultText, shareResult, flashButtonText, type ResultRow } from '../../../lib/ui/resultActions';

  function parseBRLNumber(raw: string): number {
    if (!raw || raw.trim() === '') return 0;
    const cleaned = raw.replace(/\s/g, '');
    const hasComma = cleaned.includes(',');
    const normalized = hasComma ? cleaned.replace(/\./g, '').replace(',', '.') : cleaned;
    return parseFloat(normalized);
  }

  function toggleRow(id: string, show: boolean) {
    const el = document.getElementById(id)!;
    el.classList.toggle('hidden', !show);
    el.classList.toggle('flex', show);
  }

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const resultEl = document.getElementById('result') as HTMLDivElement;

  (function loadFromURL() {
    const params = new URLSearchParams(window.location.search);
    if (!params.has('ad') || !params.has('td')) return;
    (document.getElementById('monthlySalary') as HTMLInputElement).value = (params.get('s') ?? '').replace('.', ',');
    (document.getElementById('admissionDate') as HTMLInputElement).value = params.get('ad')!;
    (document.getElementById('terminationDate') as HTMLInputElement).value = params.get('td')!;
    if (params.has('sc')) (document.getElementById('scenario') as HTMLSelectElement).value = params.get('sc')!;
    form.requestSubmit();
  })();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    document.querySelectorAll('[role="alert"]').forEach((el) => (el.textContent = ''));

    const monthlySalary = parseBRLNumber((document.getElementById('monthlySalary') as HTMLInputElement).value);
    const admissionDate = (document.getElementById('admissionDate') as HTMLInputElement).value;
    const terminationDate = (document.getElementById('terminationDate') as HTMLInputElement).value;
    const scenario = (document.getElementById('scenario') as HTMLSelectElement).value as TerminationScenario;
    const overdueVacationDays = parseInt((document.getElementById('overdueVacationDays') as HTMLInputElement).value || '0', 10);
    const fgtsBalanceRaw = (document.getElementById('fgtsBalance') as HTMLInputElement).value;
    const fgtsBalance = fgtsBalanceRaw.trim() === '' ? undefined : parseBRLNumber(fgtsBalanceRaw);
    const dependents = parseInt((document.getElementById('dependents') as HTMLInputElement).value || '0', 10);
    const alimony = parseBRLNumber((document.getElementById('alimony') as HTMLInputElement).value);

    if (!admissionDate || !terminationDate) {
      (document.getElementById('dates-error') as HTMLElement).textContent = 'Informe as duas datas.';
      resultEl.classList.add('hidden');
      return;
    }

    try {
      const r = calculateTermination({
        monthlySalary,
        admissionDate,
        terminationDate,
        scenario,
        overdueVacationDays,
        fgtsBalance,
        dependents,
        alimony,
      });

      (document.getElementById('result-value') as HTMLElement).textContent = formatBRL(r.totalNet);
      (document.getElementById('r-balance-days') as HTMLElement).textContent = String(r.balanceSalaryDays);
      (document.getElementById('r-balance') as HTMLElement).textContent = formatBRL(r.balanceSalary);

      toggleRow('r-notice-row', r.noticeDays > 0);
      if (r.noticeDays > 0) {
        (document.getElementById('r-notice-days') as HTMLElement).textContent = String(r.noticeDays);
        (document.getElementById('r-notice') as HTMLElement).textContent = `+ ${formatBRL(r.noticeValue)}`;
      }

      toggleRow('r-overdue-row', r.overdueVacationValue > 0);
      if (r.overdueVacationValue > 0) {
        (document.getElementById('r-overdue') as HTMLElement).textContent = formatBRL(r.overdueVacationValue);
      }

      toggleRow('r-propvac-row', r.proportionalVacationValue > 0);
      if (r.proportionalVacationValue > 0) {
        (document.getElementById('r-propvac-months') as HTMLElement).textContent = String(r.proportionalVacationMonths);
        (document.getElementById('r-propvac') as HTMLElement).textContent = formatBRL(r.proportionalVacationValue);
      }

      toggleRow('r-third-row', r.vacationThird > 0);
      if (r.vacationThird > 0) {
        (document.getElementById('r-third') as HTMLElement).textContent = formatBRL(r.vacationThird);
      }

      toggleRow('r-13-row', r.proportionalThirteenthGross > 0);
      if (r.proportionalThirteenthGross > 0) {
        (document.getElementById('r-13-months') as HTMLElement).textContent = String(r.proportionalThirteenthMonths);
        (document.getElementById('r-13') as HTMLElement).textContent = formatBRL(r.proportionalThirteenthGross);
      }

      const totalInss = r.balanceSalaryInss + r.vacationInss + r.thirteenthInss;
      const totalIrrf = r.balanceSalaryIrrf + r.vacationIrrf + r.thirteenthIrrf;
      (document.getElementById('r-inss') as HTMLElement).textContent = `− ${formatBRL(totalInss)}`;
      (document.getElementById('r-irrf') as HTMLElement).textContent = `− ${formatBRL(totalIrrf)}`;

      toggleRow('r-fgts-row', r.fgtsFineAmount !== null && r.fgtsFineAmount > 0);
      if (r.fgtsFineAmount !== null && r.fgtsFineAmount > 0) {
        (document.getElementById('r-fgts-rate') as HTMLElement).textContent = `${(r.fgtsFineRate * 100).toFixed(0)}%`;
        (document.getElementById('r-fgts') as HTMLElement).textContent = `+ ${formatBRL(r.fgtsFineAmount)}`;
      }

      resultEl.classList.remove('hidden');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      lastResult = r;
      lastTotalInss = totalInss;
      lastTotalIrrf = totalIrrf;
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Entrada inválida.';
      (document.getElementById('dates-error') as HTMLElement).textContent = msg;
      resultEl.classList.add('hidden');
    }
  });

  let lastResult: ReturnType<typeof calculateTermination> | null = null;
  let lastTotalInss = 0;
  let lastTotalIrrf = 0;

  function buildRows(r: NonNullable<typeof lastResult>): ResultRow[] {
    const rows: ResultRow[] = [
      { label: `Saldo de salário (${r.balanceSalaryDays} dias)`, value: formatBRL(r.balanceSalary) },
    ];
    if (r.noticeDays > 0) {
      rows.push({ label: `Aviso prévio indenizado (${r.noticeDays} dias, isento)`, value: `+ ${formatBRL(r.noticeValue)}` });
    }
    if (r.overdueVacationValue > 0) {
      rows.push({ label: 'Férias vencidas', value: formatBRL(r.overdueVacationValue) });
    }
    if (r.proportionalVacationValue > 0) {
      rows.push({
        label: `Férias proporcionais (${r.proportionalVacationMonths} meses)`,
        value: formatBRL(r.proportionalVacationValue),
      });
    }
    if (r.vacationThird > 0) {
      rows.push({ label: '1/3 constitucional sobre férias', value: formatBRL(r.vacationThird) });
    }
    if (r.proportionalThirteenthGross > 0) {
      rows.push({
        label: `13º proporcional (${r.proportionalThirteenthMonths} meses)`,
        value: formatBRL(r.proportionalThirteenthGross),
      });
    }
    rows.push({ label: 'INSS total', value: `− ${formatBRL(lastTotalInss)}`, color: '#b3401f' });
    rows.push({ label: 'IRRF total', value: `− ${formatBRL(lastTotalIrrf)}`, color: '#b3401f' });
    if (r.fgtsFineAmount !== null && r.fgtsFineAmount > 0) {
      rows.push({ label: `Multa do FGTS (${(r.fgtsFineRate * 100).toFixed(0)}%)`, value: `+ ${formatBRL(r.fgtsFineAmount)}` });
    }
    rows.push({ label: 'Total líquido', value: formatBRL(r.totalNet), emphasis: true });
    return rows;
  }

  document.getElementById('action-print')?.addEventListener('click', () => window.print());

  document.getElementById('action-copy')?.addEventListener('click', async (e) => {
    if (!lastResult) return;
    const ok = await copyResultText(buildRows(lastResult).map((row) => `${row.label}: ${row.value}`));
    if (ok) flashButtonText(e.currentTarget as HTMLButtonElement, 'Copiado!');
  });

  document.getElementById('action-share')?.addEventListener('click', async (e) => {
    if (!lastResult) return;
    const outcome = await shareResult(
      {
        s: (document.getElementById('monthlySalary') as HTMLInputElement).value.replace(/\./g, '').replace(',', '.'),
        ad: (document.getElementById('admissionDate') as HTMLInputElement).value,
        td: (document.getElementById('terminationDate') as HTMLInputElement).value,
        sc: lastResult.scenario,
      },
      `Rescisão CLT: total líquido estimado de ${formatBRL(lastResult.totalNet)}, calculado no Salário Claro`
    );
    if (outcome === 'copied') flashButtonText(e.currentTarget as HTMLButtonElement, 'Link copiado!');
  });

  document.getElementById('action-download')?.addEventListener('click', () => {
    if (!lastResult) return;
    downloadResultImage({
      title: 'Total líquido estimado da rescisão',
      bigValue: formatBRL(lastResult.totalNet),
      rows: buildRows(lastResult),
      filename: 'rescisao-salarioclaro',
    });
  });
</script>

---
import Layout from '../../../layouts/Layout.astro';
import ResultActions from '../../../components/ResultActions.astro';
import AllCalculatorsNav from '../../../components/AllCalculatorsNav.astro';
import { organizationRef, breadcrumbSchema, SITE_URL } from '../../../lib/seo/schema';

const title = 'Calculadora de Salário Proporcional | Salário Claro';
const description =
  'Calcule o salário proporcional para admissão, demissão ou afastamento no meio do mês, com o divisor correto pelo número real de dias do mês.';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${SITE_URL}/calculadoras/salario-proporcional/#webapplication`,
  name: 'Calculadora de Salário Proporcional',
  url: `${SITE_URL}/calculadoras/salario-proporcional/`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (navegador web)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  publisher: organizationRef(),
};
const breadcrumb = breadcrumbSchema([
  { name: 'Início', path: '/' },
  { name: 'Calculadoras', path: '/calculadoras/' },
  { name: 'Salário Proporcional', path: '/calculadoras/salario-proporcional/' },
]);
---
<Layout title={title} description={description} path="/calculadoras/salario-proporcional/" structuredData={[webAppSchema, breadcrumb]}>
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">Calculadora de salário proporcional</h1>
    <p class="mt-3 text-ink-soft">
      Para quem foi admitido, desligado ou teve afastamento no meio do mês. O cálculo usa o número
      real de dias do mês de referência (28, 29, 30 ou 31) como divisor, conforme o art. 64 da CLT.
    </p>

    <form id="calc-form" class="card-premium mt-8 space-y-5 rounded-xl p-6" novalidate>
      <div>
        <label for="monthlySalary" class="block text-sm font-medium text-ink">Salário mensal integral</label>
        <div class="mt-1.5 flex items-center rounded-md border border-line focus-within:border-ink">
          <span class="pl-3 text-ink-soft">R$</span>
          <input type="text" inputmode="decimal" id="monthlySalary" placeholder="3.000,00"
            class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" required />
        </div>
        <p id="monthlySalary-error" class="mt-1 text-sm text-bad" role="alert"></p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="refMonth" class="block text-sm font-medium text-ink">Mês de referência</label>
          <input type="month" id="refMonth" class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
          <p class="mt-1 text-xs text-ink-soft">Usado só para calcular quantos dias o mês tem.</p>
        </div>
        <div>
          <label for="daysInMonth" class="block text-sm font-medium text-ink">Dias do mês</label>
          <input type="number" id="daysInMonth" min="28" max="31" value="30"
            class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
          <p id="daysInMonth-error" class="mt-1 text-xs text-bad" role="alert"></p>
        </div>
      </div>

      <div>
        <label for="daysWorked" class="block text-sm font-medium text-ink">Dias trabalhados (ou devidos) no mês</label>
        <input type="number" id="daysWorked" min="0" value="15"
          class="mt-1.5 w-40 rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
        <p id="daysWorked-error" class="mt-1 text-sm text-bad" role="alert"></p>
      </div>

      <button type="submit" class="btn-primary rounded-md px-6 py-2.5 text-sm font-medium">Calcular</button>
    </form>

    <div id="result" class="card-premium mt-8 hidden rounded-xl p-6" aria-live="polite">
      <p class="text-sm text-ink-soft">Salário proporcional</p>
      <p id="result-value" class="mt-1 font-display text-4xl font-semibold tabular-money text-ink"></p>
      <p id="result-detail" class="mt-3 text-sm text-ink-soft"></p>
      <ResultActions />
      <p class="mt-6 text-xs text-ink-soft">
        Este valor é o proporcional bruto (antes de INSS e IRRF). Para saber o valor líquido, use o
        resultado aqui como salário bruto na
        <a href="/calculadoras/salario-liquido/" class="text-ink underline hover:text-accent-ink">calculadora de salário líquido</a>.
      </p>
    </div>

    <div class="prose-custom mt-12 space-y-4 text-ink">
      <h2 class="font-display text-xl font-semibold">Como calculamos</h2>
      <p class="text-ink-soft">
        O art. 64 da CLT determina que, quando o número de dias trabalhados no mês é inferior a 30,
        usa-se o número real de dias do mês (e não sempre 30) para chegar ao valor diário. O
        cálculo é: <strong>salário mensal ÷ dias do mês × dias trabalhados</strong>. Em fevereiro
        (28 ou 29 dias), por exemplo, o valor do dia é maior do que em um mês de 31 dias, para o
        mesmo salário, porque o mesmo salário mensal está sendo dividido por menos dias.
      </p>
      <p class="text-ink-soft">
        Existe controvérsia entre alguns sindicatos e convenções coletivas que preferem usar sempre
        o divisor 30, independentemente do mês. Como essa calculadora mostra exatamente o divisor
        usado em cada cálculo, você pode comparar com a convenção da sua categoria se ela definir
        uma regra diferente.
      </p>
    </div>
    <AllCalculatorsNav currentPath="/calculadoras/salario-proporcional/" />
  </section>
</Layout>

<script>
  import { calculateProportionalPay, daysInCalendarMonth } from '../../../lib/calculations/proportional';
  import { formatBRL } from '../../../lib/calculations/salary';
  import { downloadResultImage, copyResultText, shareResult, flashButtonText } from '../../../lib/ui/resultActions';

  function parseBRLNumber(raw: string): number {
    if (!raw || raw.trim() === '') return NaN;
    const cleaned = raw.replace(/\s/g, '');
    const hasComma = cleaned.includes(',');
    const normalized = hasComma ? cleaned.replace(/\./g, '').replace(',', '.') : cleaned;
    return parseFloat(normalized);
  }

  const refMonthInput = document.getElementById('refMonth') as HTMLInputElement;
  const daysInMonthInput = document.getElementById('daysInMonth') as HTMLInputElement;

  refMonthInput?.addEventListener('change', () => {
    if (!refMonthInput.value) return;
    const [year, month] = refMonthInput.value.split('-').map(Number);
    daysInMonthInput.value = String(daysInCalendarMonth(year, month));
  });

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const resultEl = document.getElementById('result') as HTMLDivElement;
  let lastResult: ReturnType<typeof calculateProportionalPay> | null = null;

  (function loadFromURL() {
    const params = new URLSearchParams(window.location.search);
    if (!params.has('b')) return;
    (document.getElementById('monthlySalary') as HTMLInputElement).value = (params.get('b') ?? '').replace('.', ',');
    if (params.has('dm')) (document.getElementById('daysInMonth') as HTMLInputElement).value = params.get('dm')!;
    if (params.has('dw')) (document.getElementById('daysWorked') as HTMLInputElement).value = params.get('dw')!;
    form.requestSubmit();
  })();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    document.querySelectorAll('[role="alert"]').forEach((el) => (el.textContent = ''));

    const monthlySalary = parseBRLNumber((document.getElementById('monthlySalary') as HTMLInputElement).value);
    const daysInMonth = parseInt(daysInMonthInput.value || '0', 10);
    const daysWorked = parseInt((document.getElementById('daysWorked') as HTMLInputElement).value || '0', 10);

    try {
      const result = calculateProportionalPay({ monthlySalary, daysInMonth, daysWorked });
      lastResult = result;
      (document.getElementById('result-value') as HTMLElement).textContent = formatBRL(result.proportionalPay);
      (document.getElementById('result-detail') as HTMLElement).textContent =
        `${formatBRL(result.monthlySalary)} ÷ ${result.daysInMonth} dias × ${result.daysWorked} dias trabalhados = ${formatBRL(result.dailyRate)}/dia`;
      resultEl.classList.remove('hidden');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Entrada inválida.';
      (document.getElementById('daysWorked-error') as HTMLElement).textContent = msg;
      resultEl.classList.add('hidden');
    }
  });

  document.getElementById('action-print')?.addEventListener('click', () => window.print());

  document.getElementById('action-copy')?.addEventListener('click', async (e) => {
    if (!lastResult) return;
    const ok = await copyResultText([
      `Salário mensal: ${formatBRL(lastResult.monthlySalary)}`,
      `Dias do mês: ${lastResult.daysInMonth}`,
      `Dias trabalhados: ${lastResult.daysWorked}`,
      `Salário proporcional: ${formatBRL(lastResult.proportionalPay)}`,
    ]);
    if (ok) flashButtonText(e.currentTarget as HTMLButtonElement, 'Copiado!');
  });

  document.getElementById('action-share')?.addEventListener('click', async (e) => {
    if (!lastResult) return;
    const outcome = await shareResult(
      { b: lastResult.monthlySalary, dm: lastResult.daysInMonth, dw: lastResult.daysWorked },
      `Salário proporcional: ${formatBRL(lastResult.proportionalPay)}, calculado no Salário Claro`
    );
    if (outcome === 'copied') flashButtonText(e.currentTarget as HTMLButtonElement, 'Link copiado!');
  });

  document.getElementById('action-download')?.addEventListener('click', () => {
    if (!lastResult) return;
    downloadResultImage({
      title: 'Salário proporcional',
      bigValue: formatBRL(lastResult.proportionalPay),
      rows: [
        { label: 'Salário mensal', value: formatBRL(lastResult.monthlySalary) },
        { label: 'Dias do mês', value: String(lastResult.daysInMonth) },
        { label: 'Dias trabalhados', value: String(lastResult.daysWorked) },
        { label: 'Salário proporcional', value: formatBRL(lastResult.proportionalPay), emphasis: true },
      ],
      filename: 'salario-proporcional-salarioclaro',
    });
  });
</script>

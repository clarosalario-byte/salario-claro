---
import Layout from '../../../layouts/Layout.astro';
import ResultActions from '../../../components/ResultActions.astro';
import AllCalculatorsNav from '../../../components/AllCalculatorsNav.astro';
import { organizationRef, breadcrumbSchema, SITE_URL } from '../../../lib/seo/schema';

const title = 'Calculadora de 13º Salário | Salário Claro';
const description =
  'Calcule o 13º salário proporcional aos meses trabalhados, com as duas parcelas, INSS e IRRF, com as regras de 2026.';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${SITE_URL}/calculadoras/13-salario/#webapplication`,
  name: 'Calculadora de 13º Salário 2026',
  url: `${SITE_URL}/calculadoras/13-salario/`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (navegador web)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  publisher: organizationRef(),
};
const breadcrumb = breadcrumbSchema([
  { name: 'Início', path: '/' },
  { name: 'Calculadoras', path: '/calculadoras/' },
  { name: '13º Salário', path: '/calculadoras/13-salario/' },
]);
---
<Layout title={title} description={description} path="/calculadoras/13-salario/" structuredData={[webAppSchema, breadcrumb]}>
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">Calculadora de 13º salário</h1>
    <p class="mt-3 text-ink-soft">
      Calcula o 13º proporcional aos meses trabalhados, dividido nas duas parcelas legais.
    </p>

    <form id="calc-form" class="card-premium mt-8 space-y-5 rounded-xl p-6" novalidate>
      <div>
        <label for="monthlySalary" class="block text-sm font-medium text-ink">Salário mensal (base do 13º)</label>
        <div class="mt-1.5 flex max-w-xs items-center rounded-md border border-line focus-within:border-ink">
          <span class="pl-3 text-ink-soft">R$</span>
          <input type="text" inputmode="decimal" id="monthlySalary" placeholder="3.000,00"
            class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" required />
        </div>
        <p id="monthlySalary-error" class="mt-1 text-sm text-bad" role="alert"></p>
      </div>

      <div>
        <label for="monthsWorked" class="block text-sm font-medium text-ink">Meses trabalhados no ano</label>
        <input type="number" id="monthsWorked" min="0" max="12" value="12"
          class="mt-1.5 w-32 rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
        <p id="monthsWorked-error" class="mt-1 text-sm text-bad" role="alert"></p>
        <p class="mt-1 text-xs text-ink-soft">Cada mês com 15 dias ou mais trabalhados conta como um mês completo.</p>
      </div>

      <details class="rounded-md border border-line p-4">
        <summary class="cursor-pointer select-none text-sm font-medium text-ink">Mais opções</summary>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="dependents" class="block text-sm font-medium text-ink">Dependentes</label>
            <input type="number" id="dependents" min="0" value="0"
              class="mt-1.5 w-full rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
          </div>
          <div>
            <label for="alimony" class="block text-sm font-medium text-ink">Pensão alimentícia</label>
            <div class="mt-1.5 flex items-center rounded-md border border-line focus-within:border-ink">
              <span class="pl-3 text-ink-soft">R$</span>
              <input type="text" inputmode="decimal" id="alimony" placeholder="0,00"
                class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" />
            </div>
          </div>
        </div>
      </details>

      <button type="submit" class="btn-primary rounded-md px-6 py-2.5 text-sm font-medium">Calcular</button>
    </form>

    <div id="result" class="card-premium mt-8 hidden rounded-xl p-6" aria-live="polite">
      <p class="text-sm text-ink-soft">Total líquido do 13º</p>
      <p id="result-value" class="mt-1 font-display text-4xl font-semibold tabular-money text-ink"></p>
      <dl class="mt-6 divide-y divide-line border-t border-line text-sm">
        <div class="flex justify-between py-2"><dt class="text-ink-soft">13º bruto</dt><dd id="r-gross" class="tabular-money"></dd></div>
        <div class="flex justify-between py-2"><dt class="text-ink-soft">1ª parcela (sem desconto, até 30/11)</dt><dd id="r-first" class="tabular-money"></dd></div>
        <div class="flex justify-between py-2"><dt class="text-ink-soft">2ª parcela bruta (até 20/12)</dt><dd id="r-second-gross" class="tabular-money"></dd></div>
        <div class="flex justify-between py-2"><dt class="text-ink-soft">INSS (sobre o valor integral)</dt><dd id="r-inss" class="tabular-money text-bad"></dd></div>
        <div class="flex justify-between py-2"><dt class="text-ink-soft">IRRF (sobre o valor integral)</dt><dd id="r-irrf" class="tabular-money text-bad"></dd></div>
        <div class="flex justify-between py-2 font-medium"><dt class="text-ink">2ª parcela líquida</dt><dd id="r-second-net" class="tabular-money"></dd></div>
      </dl>
      <ResultActions />
      <p class="mt-4 text-xs text-ink-soft">
        Este cálculo é uma estimativa e não substitui o holerite oficial ou a orientação de um
        profissional de contabilidade.
      </p>
    </div>

    <div class="prose-custom mt-12 space-y-4 text-ink">
      <h2 class="font-display text-xl font-semibold">Como calculamos</h2>
      <p class="text-ink-soft">
        O 13º corresponde a 1/12 do salário por mês trabalhado (mês com 15 dias ou mais conta como
        completo). A 1ª parcela, paga até 30 de novembro, é metade do valor bruto, sem nenhum
        desconto. O INSS e o IRRF são calculados uma única vez, sobre o valor <strong>integral</strong>
        do 13º, e descontados inteiramente na 2ª parcela. A redução de imposto de 2026 também vale
        para o 13º, isso está previsto expressamente na própria Lei 15.270/2025. Fontes completas em
        <a href="/como-calculamos/" class="text-ink underline hover:text-accent-ink">Como calculamos</a>.
      </p>
    </div>
    <AllCalculatorsNav currentPath="/calculadoras/13-salario/" />
  </section>
</Layout>

<script>
  import { calculateThirteenth } from '../../../lib/calculations/thirteenth';
  import { formatBRL } from '../../../lib/calculations/salary';
  import { downloadResultImage, copyResultText, shareResult, flashButtonText, type ResultRow } from '../../../lib/ui/resultActions';

  function parseBRLNumber(raw: string): number {
    if (!raw || raw.trim() === '') return 0;
    const cleaned = raw.replace(/\s/g, '');
    const hasComma = cleaned.includes(',');
    const normalized = hasComma ? cleaned.replace(/\./g, '').replace(',', '.') : cleaned;
    return parseFloat(normalized);
  }

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const resultEl = document.getElementById('result') as HTMLDivElement;

  (function loadFromURL() {
    const params = new URLSearchParams(window.location.search);
    if (!params.has('s')) return;
    (document.getElementById('monthlySalary') as HTMLInputElement).value = (params.get('s') ?? '').replace('.', ',');
    if (params.has('m')) (document.getElementById('monthsWorked') as HTMLInputElement).value = params.get('m')!;
    form.requestSubmit();
  })();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    document.querySelectorAll('[role="alert"]').forEach((el) => (el.textContent = ''));

    const monthlySalary = parseBRLNumber((document.getElementById('monthlySalary') as HTMLInputElement).value);
    const monthsWorked = parseInt((document.getElementById('monthsWorked') as HTMLInputElement).value || '0', 10);
    const dependents = parseInt((document.getElementById('dependents') as HTMLInputElement).value || '0', 10);
    const alimony = parseBRLNumber((document.getElementById('alimony') as HTMLInputElement).value);

    try {
      const r = calculateThirteenth({ monthlySalary, monthsWorked, dependents, alimony });
      (document.getElementById('result-value') as HTMLElement).textContent = formatBRL(r.totalNet);
      (document.getElementById('r-gross') as HTMLElement).textContent = formatBRL(r.grossThirteenth);
      (document.getElementById('r-first') as HTMLElement).textContent = formatBRL(r.firstInstallment);
      (document.getElementById('r-second-gross') as HTMLElement).textContent = formatBRL(r.secondInstallmentGross);
      (document.getElementById('r-inss') as HTMLElement).textContent = `− ${formatBRL(r.inssTotal)}`;
      (document.getElementById('r-irrf') as HTMLElement).textContent = `− ${formatBRL(r.irrfTotal)}`;
      (document.getElementById('r-second-net') as HTMLElement).textContent = formatBRL(r.secondInstallmentNet);

      resultEl.classList.remove('hidden');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      lastResult = r;
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Entrada inválida.';
      (document.getElementById('monthsWorked-error') as HTMLElement).textContent = msg;
      resultEl.classList.add('hidden');
    }
  });


  let lastResult: ReturnType<typeof calculateThirteenth> | null = null;

  document.getElementById('action-print')?.addEventListener('click', () => window.print());

  document.getElementById('action-copy')?.addEventListener('click', async (e) => {
    if (!lastResult) return;
    const ok = await copyResultText([
      `13º bruto: ${formatBRL(lastResult.grossThirteenth)}`,
      `1ª parcela: ${formatBRL(lastResult.firstInstallment)}`,
      `2ª parcela bruta: ${formatBRL(lastResult.secondInstallmentGross)}`,
      `INSS: − ${formatBRL(lastResult.inssTotal)}`,
      `IRRF: − ${formatBRL(lastResult.irrfTotal)}`,
      `Total líquido: ${formatBRL(lastResult.totalNet)}`,
    ]);
    if (ok) flashButtonText(e.currentTarget as HTMLButtonElement, 'Copiado!');
  });

  document.getElementById('action-share')?.addEventListener('click', async (e) => {
    if (!lastResult) return;
    const outcome = await shareResult(
      {
        s: (document.getElementById('monthlySalary') as HTMLInputElement).value.replace(/\./g, '').replace(',', '.'),
        m: lastResult.monthsWorked,
      },
      `13º líquido: ${formatBRL(lastResult.totalNet)}, calculado no Salário Claro`
    );
    if (outcome === 'copied') flashButtonText(e.currentTarget as HTMLButtonElement, 'Link copiado!');
  });

  document.getElementById('action-download')?.addEventListener('click', () => {
    if (!lastResult) return;
    const rows: ResultRow[] = [
      { label: '13º bruto', value: formatBRL(lastResult.grossThirteenth) },
      { label: '1ª parcela (sem desconto)', value: formatBRL(lastResult.firstInstallment) },
      { label: '2ª parcela bruta', value: formatBRL(lastResult.secondInstallmentGross) },
      { label: 'INSS', value: `− ${formatBRL(lastResult.inssTotal)}`, color: '#b3401f' },
      { label: 'IRRF', value: `− ${formatBRL(lastResult.irrfTotal)}`, color: '#b3401f' },
      { label: 'Total líquido', value: formatBRL(lastResult.totalNet), emphasis: true },
    ];
    downloadResultImage({
      title: 'Total líquido do 13º salário',
      bigValue: formatBRL(lastResult.totalNet),
      badge: 'Regras 2026',
      rows,
      filename: '13-salario-salarioclaro',
    });
  });
</script>
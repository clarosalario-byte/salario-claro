---
import Layout from '../../../layouts/Layout.astro';
import ResultActions from '../../../components/ResultActions.astro';
import AllCalculatorsNav from '../../../components/AllCalculatorsNav.astro';
import { organizationRef, breadcrumbSchema, SITE_URL } from '../../../lib/seo/schema';

const title = 'Calculadora de FGTS: Depósito e Multa Rescisória';
const description =
  'Calcule o depósito mensal do FGTS (8% do salário) e a multa rescisória (40% ou 20%), com base na Lei 8.036/1990.';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${SITE_URL}/calculadoras/fgts/#webapplication`,
  name: 'Calculadora de FGTS',
  url: `${SITE_URL}/calculadoras/fgts/`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (navegador web)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  publisher: organizationRef(),
};
const breadcrumb = breadcrumbSchema([
  { name: 'Início', path: '/' },
  { name: 'Calculadoras', path: '/calculadoras/' },
  { name: 'FGTS', path: '/calculadoras/fgts/' },
]);
---
<Layout title={title} description={description} path="/calculadoras/fgts/" structuredData={[webAppSchema, breadcrumb]}>
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">Calculadora de FGTS</h1>
    <p class="mt-3 text-ink-soft">
      O FGTS é um depósito feito pelo empregador: não é descontado do seu salário. Calcule o
      depósito mensal, uma projeção acumulada, e a multa rescisória.
    </p>

    <div class="card-premium mt-8 rounded-xl p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Depósito mensal e projeção</h2>
      <form id="deposit-form" class="mt-4 space-y-5" novalidate>
        <div>
          <label for="monthlySalary" class="block text-sm font-medium text-ink">Salário mensal (remuneração bruta)</label>
          <div class="mt-1.5 flex max-w-xs items-center rounded-md border border-line focus-within:border-ink">
            <span class="pl-3 text-ink-soft">R$</span>
            <input type="text" inputmode="decimal" id="monthlySalary" placeholder="3.000,00"
              class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" required />
          </div>
          <p id="monthlySalary-error" class="mt-1 text-sm text-bad" role="alert"></p>
        </div>
        <div>
          <label for="months" class="block text-sm font-medium text-ink">Projetar para quantos meses?</label>
          <input type="number" id="months" min="1" max="600" value="12"
            class="mt-1.5 w-32 rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink" />
        </div>
        <button type="submit" class="btn-primary rounded-md px-6 py-2.5 text-sm font-medium">Calcular depósito</button>
      </form>

      <div id="deposit-result" class="mt-6 hidden border-t border-line pt-6" aria-live="polite">
        <dl class="space-y-1.5 text-sm">
          <div class="flex justify-between"><dt class="text-ink-soft">Depósito mensal (8%)</dt><dd id="d-monthly" class="tabular-money font-medium"></dd></div>
          <div class="flex justify-between"><dt class="text-ink-soft">Projeção acumulada (<span id="d-months-label"></span>)</dt><dd id="d-accumulated" class="tabular-money"></dd></div>
        </dl>
        <p class="mt-3 text-xs text-ink-soft">
          Esta projeção soma apenas os depósitos de 8% (valor principal), sem correção monetária
          (TR) nem os juros de 3% ao ano que uma conta real do FGTS recebe. Essas taxas mudam
          mensalmente e são publicadas pela Caixa. O saldo real tende a ser maior que esta projeção.
        </p>
        <ResultActions idPrefix="deposit-" />
      </div>
    </div>

    <div class="card-premium mt-6 rounded-xl p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Multa rescisória</h2>
      <form id="fine-form" class="mt-4 space-y-5" novalidate>
        <div>
          <label for="fgtsBalance" class="block text-sm font-medium text-ink">Saldo acumulado do FGTS</label>
          <div class="mt-1.5 flex max-w-xs items-center rounded-md border border-line focus-within:border-ink">
            <span class="pl-3 text-ink-soft">R$</span>
            <input type="text" inputmode="decimal" id="fgtsBalance" placeholder="2.880,00"
              class="w-full rounded-md bg-transparent px-2 py-2.5 tabular-money outline-none" required />
          </div>
          <p class="mt-1 text-xs text-ink-soft">Use o extrato oficial (app FGTS/Caixa) para o valor real, ou a projeção acima.</p>
          <p id="fgtsBalance-error" class="mt-1 text-sm text-bad" role="alert"></p>
        </div>
        <div>
          <label for="terminationType" class="block text-sm font-medium text-ink">Tipo de desligamento</label>
          <select id="terminationType" class="mt-1.5 w-full max-w-sm rounded-md border border-line px-3 py-2.5 outline-none focus:border-ink">
            <option value="no-cause">Dispensa sem justa causa (multa de 40%)</option>
            <option value="mutual-agreement">Acordo mútuo / distrato (multa de 20%)</option>
            <option value="no-fine">Pedido de demissão ou justa causa (sem multa)</option>
          </select>
        </div>
        <button type="submit" class="btn-primary rounded-md px-6 py-2.5 text-sm font-medium">Calcular multa</button>
      </form>

      <div id="fine-result" class="mt-6 hidden border-t border-line pt-6" aria-live="polite">
        <p class="text-sm text-ink-soft">Multa rescisória</p>
        <p id="fine-value" class="mt-1 font-display text-3xl font-semibold tabular-money text-ink"></p>
        <ResultActions idPrefix="fine-" />
      </div>
    </div>

    <div class="prose-custom mt-12 space-y-4 text-ink">
      <h2 class="font-display text-xl font-semibold">Como calculamos</h2>
      <p class="text-ink-soft">
        O depósito mensal é 8% da remuneração (Lei 8.036/1990, art. 15). Em dispensa sem justa
        causa, o empregador paga uma multa de 40% sobre todo o saldo acumulado (art. 18, §1º). Em
        rescisão por acordo entre as partes (art. 484-A da CLT), a multa é de 20%. Não há multa em
        pedido de demissão ou dispensa por justa causa. Fontes completas em
        <a href="/como-calculamos/" class="text-ink underline hover:text-accent-ink">Como calculamos</a>.
      </p>
    </div>
    <AllCalculatorsNav currentPath="/calculadoras/fgts/" />
  </section>
</Layout>

<script>
  import { calculateFgtsDeposit, calculateFgtsFine, type TerminationType } from '../../../lib/calculations/fgts';
  import { formatBRL } from '../../../lib/calculations/salary';
  import { downloadResultImage, copyResultText, shareResult, flashButtonText } from '../../../lib/ui/resultActions';

  function parseBRLNumber(raw: string): number {
    if (!raw || raw.trim() === '') return NaN;
    const cleaned = raw.replace(/\s/g, '');
    const hasComma = cleaned.includes(',');
    const normalized = hasComma ? cleaned.replace(/\./g, '').replace(',', '.') : cleaned;
    return parseFloat(normalized);
  }

  const depositForm = document.getElementById('deposit-form') as HTMLFormElement;
  depositForm.addEventListener('submit', (e) => {
    e.preventDefault();
    (document.getElementById('monthlySalary-error') as HTMLElement).textContent = '';

    const monthlySalary = parseBRLNumber((document.getElementById('monthlySalary') as HTMLInputElement).value);
    const months = parseInt((document.getElementById('months') as HTMLInputElement).value || '1', 10);

    try {
      const r = calculateFgtsDeposit({ monthlySalary, months });
      lastDeposit = r;
      (document.getElementById('d-monthly') as HTMLElement).textContent = formatBRL(r.monthlyDeposit);
      (document.getElementById('d-months-label') as HTMLElement).textContent = `${r.months} ${r.months === 1 ? 'mês' : 'meses'}`;
      (document.getElementById('d-accumulated') as HTMLElement).textContent = formatBRL(r.projectedPrincipalBalance);
      document.getElementById('deposit-result')!.classList.remove('hidden');

      // Convenience: prefill the fine calculator with this projection.
      (document.getElementById('fgtsBalance') as HTMLInputElement).value = r.projectedPrincipalBalance
        .toFixed(2)
        .replace('.', ',');
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Entrada inválida.';
      (document.getElementById('monthlySalary-error') as HTMLElement).textContent = msg;
    }
  });

  const fineForm = document.getElementById('fine-form') as HTMLFormElement;
  let lastDeposit: ReturnType<typeof calculateFgtsDeposit> | null = null;
  let lastFine: ReturnType<typeof calculateFgtsFine> | null = null;

  (function loadFromURL() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('s')) {
      const salary = parseFloat(params.get('s') ?? '');
      if (!Number.isNaN(salary)) {
        (document.getElementById('monthlySalary') as HTMLInputElement).value = salary.toFixed(2).replace('.', ',');
        if (params.has('m')) (document.getElementById('months') as HTMLInputElement).value = params.get('m')!;
        depositForm.requestSubmit();
      }
    }
    if (params.has('fb')) {
      (document.getElementById('fgtsBalance') as HTMLInputElement).value = (params.get('fb') ?? '').replace('.', ',');
      if (params.has('tt')) (document.getElementById('terminationType') as HTMLSelectElement).value = params.get('tt')!;
      fineForm.requestSubmit();
    }
  })();

  fineForm.addEventListener('submit', (e) => {
    e.preventDefault();
    (document.getElementById('fgtsBalance-error') as HTMLElement).textContent = '';

    const fgtsBalance = parseBRLNumber((document.getElementById('fgtsBalance') as HTMLInputElement).value);
    const terminationType = (document.getElementById('terminationType') as HTMLSelectElement).value as TerminationType;

    try {
      const r = calculateFgtsFine({ fgtsBalance, terminationType });
      lastFine = r;
      (document.getElementById('fine-value') as HTMLElement).textContent = formatBRL(r.fineAmount);
      document.getElementById('fine-result')!.classList.remove('hidden');
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Entrada inválida.';
      (document.getElementById('fgtsBalance-error') as HTMLElement).textContent = msg;
    }
  });

  document.getElementById('deposit-action-print')?.addEventListener('click', () => window.print());
  document.getElementById('fine-action-print')?.addEventListener('click', () => window.print());

  document.getElementById('deposit-action-copy')?.addEventListener('click', async (e) => {
    if (!lastDeposit) return;
    const ok = await copyResultText([
      `Depósito mensal (8%): ${formatBRL(lastDeposit.monthlyDeposit)}`,
      `Projeção acumulada (${lastDeposit.months} meses): ${formatBRL(lastDeposit.projectedPrincipalBalance)}`,
    ]);
    if (ok) flashButtonText(e.currentTarget as HTMLButtonElement, 'Copiado!');
  });

  document.getElementById('deposit-action-share')?.addEventListener('click', async (e) => {
    if (!lastDeposit) return;
    const outcome = await shareResult(
      { s: lastDeposit.monthlyDeposit / 0.08, m: lastDeposit.months },
      `Depósito FGTS: ${formatBRL(lastDeposit.monthlyDeposit)}/mês, calculado no Salário Claro`
    );
    if (outcome === 'copied') flashButtonText(e.currentTarget as HTMLButtonElement, 'Link copiado!');
  });

  document.getElementById('deposit-action-download')?.addEventListener('click', () => {
    if (!lastDeposit) return;
    downloadResultImage({
      title: 'Depósito mensal do FGTS',
      bigValue: formatBRL(lastDeposit.monthlyDeposit),
      rows: [
        { label: 'Depósito mensal (8%)', value: formatBRL(lastDeposit.monthlyDeposit), emphasis: true },
        { label: `Projeção acumulada (${lastDeposit.months} meses)`, value: formatBRL(lastDeposit.projectedPrincipalBalance) },
      ],
      filename: 'fgts-deposito-salarioclaro',
    });
  });

  document.getElementById('fine-action-copy')?.addEventListener('click', async (e) => {
    if (!lastFine) return;
    const ok = await copyResultText([
      `Saldo do FGTS: ${formatBRL(lastFine.fgtsBalance)}`,
      `Alíquota da multa: ${(lastFine.fineRate * 100).toFixed(0)}%`,
      `Multa rescisória: ${formatBRL(lastFine.fineAmount)}`,
    ]);
    if (ok) flashButtonText(e.currentTarget as HTMLButtonElement, 'Copiado!');
  });

  document.getElementById('fine-action-share')?.addEventListener('click', async (e) => {
    if (!lastFine) return;
    const outcome = await shareResult(
      { fb: lastFine.fgtsBalance, tt: lastFine.terminationType },
      `Multa do FGTS: ${formatBRL(lastFine.fineAmount)}, calculado no Salário Claro`
    );
    if (outcome === 'copied') flashButtonText(e.currentTarget as HTMLButtonElement, 'Link copiado!');
  });

  document.getElementById('fine-action-download')?.addEventListener('click', () => {
    if (!lastFine) return;
    downloadResultImage({
      title: 'Multa rescisória do FGTS',
      bigValue: formatBRL(lastFine.fineAmount),
      rows: [
        { label: 'Saldo do FGTS', value: formatBRL(lastFine.fgtsBalance) },
        { label: 'Alíquota da multa', value: `${(lastFine.fineRate * 100).toFixed(0)}%` },
        { label: 'Multa rescisória', value: formatBRL(lastFine.fineAmount), emphasis: true },
      ],
      filename: 'fgts-multa-salarioclaro',
    });
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import { organizationFull, websiteFull, SITE_URL } from '../lib/seo/schema';

const title = 'Calculadora de Salário Líquido | Salário Claro';
const description =
  'Calculadora de salário líquido: veja o INSS, o IRRF e o valor líquido a partir do salário bruto. Grátis, sem cadastro, cálculo no navegador.';

const faqs = [
  {
    q: 'Como calcular o salário líquido?',
    a: 'Parta do salário bruto, subtraia o INSS (calculado por faixa progressiva) e o IRRF (calculado sobre a base de cálculo, já com a redução de 2026 quando aplicável). O valor restante, menos outros descontos como vale-transporte, é o salário líquido. A calculadora de salário líquido faz essa conta automaticamente e mostra cada etapa.',
  },
  {
    q: 'Qual a diferença entre salário bruto e salário líquido?',
    a: 'Salário bruto é o valor combinado no contrato, antes de qualquer desconto. Salário líquido é o que cai na conta depois de descontados INSS, IRRF e outros valores.',
  },
  {
    q: 'O cálculo considera INSS?',
    a: 'Sim. O INSS é calculado de forma progressiva, faixa por faixa, usando a tabela de contribuição de 2026.',
  },
  {
    q: 'O cálculo considera IRRF?',
    a: 'Sim, incluindo a redução mensal criada pela Lei 15.270/2025 para quem tem salário bruto até R$ 7.350,00.',
  },
  {
    q: 'Dependentes alteram o salário líquido?',
    a: 'Sim. Cada dependente gera uma dedução que pode reduzir a base de cálculo do IRRF, dependendo se essa dedução é mais vantajosa que o desconto simplificado.',
  },
  {
    q: 'O cálculo usa as regras de 2026?',
    a: 'Sim. A calculadora usa a tabela de IRRF de 2026, a redução da Lei 15.270/2025 e a tabela de contribuição do INSS de 2026, com fontes oficiais listadas na página Como calculamos.',
  },
  {
    q: 'O resultado do Salário Claro é oficial?',
    a: 'Não. O Salário Claro é uma calculadora independente, não é um serviço do governo nem substitui o holerite oficial. O resultado é uma estimativa para ajudar no seu planejamento.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${SITE_URL}/#webapplication`,
  name: 'Salário Claro',
  url: SITE_URL,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (navegador web)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  publisher: { '@id': `${SITE_URL}/#organization` },
};
---

<Layout
  title={title}
  description={description}
  path="/"
  structuredData={[organizationFull(), websiteFull(), webAppSchema, faqSchema]}
>
  <section class="hero-texture relative overflow-hidden py-20 sm:py-28" data-reveal>

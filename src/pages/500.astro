---
import Layout from '../layouts/Layout.astro';

const title = 'Erro no servidor | Salário Claro';
const description = 'Ocorreu um erro inesperado.';
---

<Layout title={title} description={description} path="/500/" robots="noindex, nofollow">
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-start justify-center px-5 py-16">
    <p class="font-display text-sm font-semibold text-bad">Erro 500</p>
    <h1 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">
      Algo deu errado do nosso lado.
    </h1>
    <p class="mt-3 text-ink-soft">
      Tente novamente em alguns instantes. Se o problema continuar, você pode nos avisar pela
      página de contato.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="btn-primary rounded-md px-6 py-3 text-sm font-medium"
      >
        Voltar ao início
      </a>
      <a
        href="/contato/"
        class="btn-outline rounded-md px-6 py-3 text-sm font-medium"
      >
        Falar conosco
      </a>
    </div>
  </section>
</Layout>
